{
  "name": "agent-run-monitor",
  "productName": "Agent Run Monitor",
  "version": "0.1.0",
  "description": "A local, read-only desktop monitor for coding-agent runs: Claude Code, Codex, Gemini CLI, Copilot, Aider, Cursor and more.",
  "license": "MIT",
  "author": "Agent Run Monitor contributors",
  "homepage": "https://github.com/OWNER/agent-run-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/agent-run-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/agent-run-monitor/issues"
  },
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "npm run build && playwright test -c playwright.electron.config.ts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "set-repo": "node scripts/set-repo.mjs",
    "scan-secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "chokidar": "^6.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-virtual": "^3.14.23",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gifenc": "^1.0.3",
    "jsdom": "^30.1.3",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
